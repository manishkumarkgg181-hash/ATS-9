        function getLiveLocation() {
            const badge = document.getElementById('locBadge');
            const details = document.getElementById('locDetails');
            const branchName = document.getElementById('branch').value;

            if (!navigator.geolocation) {
                badge.textContent = 'Unsupported';
                details.textContent = 'Is browser mein GPS location support nahi hai.';
                return;
            }

            badge.textContent = 'Fetching...';
            details.textContent = 'GPS location nikali ja rahi hai, kripya allow karein...';

            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    lastCoords = { lat, lng };
                    updateDistanceUI(lat, lng, branchName);
                },
                (err) => {
                    badge.textContent = 'Location Failed';
                    badge.style.color = '#dc2626';
                    details.textContent = `Location nahi mil saki (${err.message}). Kripya GPS on karein ya address manually likhein.`;
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        }

