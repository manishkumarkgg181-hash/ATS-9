<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#003399">
    <link rel="manifest" href="manifest.json">
    <title>Apna Technical Services (ATS) - Complete App</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { background-color: #eef2f6; padding-bottom: 88px; color: #0f172a; }

        /* Header */
        .header { background: #003399; color: #FFD700; padding: 14px; text-align: center; border-bottom: 4px solid #FFD700; }
        .header h1 { font-size: 20px; font-weight: 800; }
        .header p { color: #ffffff; font-size: 12px; margin-top: 3px; }
        .sync-pill { display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: bold; background: #002266; color: #FFD700; border: 1px solid #FFD700; }

        /* Customer Session Strip */
        .auth-strip { background: #ffffff; border-bottom: 1px solid #cbd5e1; padding: 8px 14px; font-size: 12px; }
        .auth-strip-inner { max-width: 600px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
        .auth-user { font-weight: 700; color: #003399; }

        /* Navigation Tabs */
        .nav-tabs { display: flex; background: #002266; border-bottom: 2px solid #FFD700; position: sticky; top: 0; z-index: 10; overflow-x: auto; }
        .nav-btn { flex: 1; min-width: 64px; padding: 11px 4px; background: none; border: none; color: #ddd; font-weight: bold; font-size: 12px; cursor: pointer; white-space: nowrap; }
        .nav-btn.active { background: #FFD700; color: #002266; }

        /* Container */
        .container { padding: 14px; max-width: 600px; margin: auto; }
        .section { display: none; }
        .section.active { display: block; }

        .section-title { color: #003399; font-size: 16px; font-weight: bold; margin: 14px 0 8px; border-left: 4px solid #FFD700; padding-left: 8px; }

        /* Clickable Poster Banner */
        .poster-box { position: relative; border-radius: 10px; overflow: hidden; border: 2px solid #003399; margin-bottom: 14px; cursor: pointer; background: #003399; }
        .poster-box img { width: 100%; display: block; max-height: 240px; object-fit: cover; }
        .poster-overlay { background: rgba(0, 34, 102, 0.92); color: #FFD700; padding: 10px 12px; display: flex; justify-content: space-between; align-items: center; }
        .poster-overlay span { font-size: 13px; font-weight: bold; }
        .poster-badge { background: #25D366; color: #fff; padding: 5px 10px; border-radius: 6px; font-size: 12px; font-weight: bold; }

        /* All Services Grid */
        .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 14px; }
        .card { background: #003399; color: white; padding: 10px 6px; border-radius: 8px; text-align: center; border: 2px solid #FFD700; cursor: pointer; transition: 0.15s; }
        .card:active { transform: scale(0.96); }
        .card span { font-size: 20px; display: block; margin-bottom: 4px; }
        .card h3 { font-size: 11.5px; color: #FFD700; line-height: 1.25; }

        /* Boxes & Forms */
        .box { background: white; padding: 14px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.08); margin-bottom: 14px; }
        label { display: block; font-size: 12px; font-weight: 600; color: #333; margin: 10px 0 4px; }
        input, select, textarea { width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; }

        .row-flex { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .btn { width: 100%; padding: 12px; font-size: 14px; font-weight: bold; border: none; border-radius: 6px; margin-top: 10px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center; }
        .btn-loc { background: #0284c7; color: #fff; padding: 9px 10px; font-size: 12px; margin-top: 0; width: auto; white-space: nowrap; }
        .btn-whatsapp { background: #25D366; color: white; }
        .btn-pay { background: #f59e0b; color: #002266; }
        .btn-primary { background: #003399; color: #FFD700; }
        .btn-done { background: #16a34a; color: white; padding: 9px; font-size: 13px; margin-top: 8px; }
        .btn-secondary { background: #e2e8f0; color: #0f172a; }
        .btn-google { background: #ffffff; color: #0f172a; border: 1px solid #cbd5e1; }
        .btn-sm { width: auto; padding: 7px 11px; font-size: 12px; margin-top: 0; }

        .loc-status { font-size: 12px; color: #0f172a; background: #f1f5f9; padding: 8px; border-radius: 6px; margin-top: 6px; word-break: break-word; }
        .range-note { font-size: 11.5px; color: #0369a1; background: #f0f9ff; border: 1px solid #bae6fd; padding: 8px; border-radius: 6px; margin-top: 6px; }
        .otp-box { background: #f0fdf4; border: 1px solid #86efac; padding: 10px; border-radius: 8px; margin-top: 10px; }

        /* Summary Strip */
        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
        .stat-box { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 8px; text-align: center; }
        .stat-box strong { display: block; font-size: 16px; color: #003399; }
        .stat-box span { font-size: 11px; color: #475569; }

        /* Cards & Lists */
        .order-card { background: #f8fafc; border: 1px solid #cbd5e1; border-left: 5px solid #003399; padding: 12px; border-radius: 8px; margin-bottom: 10px; }
        .order-card h4 { color: #003399; font-size: 14px; margin-bottom: 4px; }
        .order-card p { font-size: 12.5px; color: #334155; margin: 3px 0; }
        .status-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: bold; margin-top: 5px; margin-right: 4px; }
        .pending { background: #fef08a; color: #854d0e; }
        .ontheway { background: #e0f2fe; color: #0369a1; }
        .completed { background: #dcfce7; color: #166534; }
        .paid-badge { background: #dbeafe; color: #1e40af; }
        .unpaid-badge { background: #fee2e2; color: #991b1b; }

        .fb-item { border-bottom: 1px solid #e2e8f0; padding: 8px 0; font-size: 13px; }
        .fb-item:last-child { border-bottom: none; }

        .bill-box { background: #fffbeb; border: 1px dashed #d97706; padding: 12px; border-radius: 8px; margin-top: 10px; font-size: 12.5px; }

        .photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }
        .photo-card { background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px; padding: 6px; text-align: center; }
        .photo-card img { width: 100%; height: 95px; object-fit: cover; border-radius: 6px; background: #f1f5f9; }
        .photo-card span { display: block; font-size: 10.5px; font-weight: 600; color: #334155; margin-top: 4px; }

        /* Bottom Call Bar */
        .bottom-bar { position: fixed; bottom: 0; left: 0; width: 100%; background: #002266; display: flex; justify-content: space-around; padding: 10px; border-top: 2px solid #FFD700; z-index: 10; }
        .call-btn { background: #FFD700; color: #002266; text-decoration: none; padding: 7px 14px; border-radius: 20px; font-weight: bold; font-size: 13px; }
    </style>
</head>
