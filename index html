        function initCloudSync() {
            try {
                if (firebaseConfig.apiKey && firebaseConfig.databaseURL && window.firebase) {
                    if (!firebase.apps.length) {
                        firebase.initializeApp(firebaseConfig);
                    }
                    db = firebase.database();
                    cloudEnabled = true;
                    document.getElementById('syncStatus').textContent = 'Mode: Live Firebase Cloud Sync';

                    if (firebase.auth) {
                        auth = firebase.auth();
                        authEnabled = true;
                    }

                    db.ref('ats/orders').on('value', (snap) => {
                        const data = snap.val();
                        if (data) {
                            const arr = Object.values(data).sort((a, b) => b.id - a.id);
                            safeLocalSet('ats_orders_v5', arr);
                            refreshAllViews();
                        }
                    });

                    db.ref('ats/payments').on('value', (snap) => {
                        const data = snap.val();
                        if (data) {
                            const arr = Object.values(data).sort((a, b) => b.id - a.id);
                            safeLocalSet('ats_payments_v5', arr);
                            renderPayments();
                        }
                    });

                    db.ref('ats/feedbacks').on('value', (snap) => {
                        const data = snap.val();
                        if (data) {
                            const arr = Object.values(data).sort((a, b) => b.id - a.id);
                            safeLocalSet('ats_feedback_v5', arr);
                            renderFeedbacks();
                        }
                    });
                }
            } catch (e) {
                cloudEnabled = false;
                authEnabled = false;
            }
        }

