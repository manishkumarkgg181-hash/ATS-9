            const name = document.getElementById('payName').value.trim();
            const amount = parseFloat(document.getElementById('payAmount').value);
            const ref = document.getElementById('payRef').value.trim() || 'UPI Payment Recorded';

            if (!name || !amount || amount <= 0) {
                alert('Kripya Customer ka Naam aur Amount daalein.');
                return;
            }

            const pays = getPayments();
            pays.unshift({
                id: Date.now(),
                orderCode,
                name,
                amount,
                ref,
                date: new Date().toLocaleString('en-IN')
            });
            if (!savePayments(pays)) return;

            if (orderCode) {
                const orders = getOrders();
                const idx = orders.findIndex(o => o.orderCode === orderCode);
                if (idx !== -1) {
                    orders[idx].paid = true;
                    if (!orders[idx].billAmount) orders[idx].billAmount = amount;
                    saveOrders(orders);
                }
            }

            document.getElementById('payName').value = '';
            document.getElementById('payAmount').value = '';
            document.getElementById('payRef').value = '';
            alert('Payment record save ho gaya!');
        }

        function renderPayments() {
            const box = document.getElementById('payHistory');
            if (!box) return;
            const pays = getPayments();
            if (!pays.length) {
                box.innerHTML = `<p style="font-size:12.5px; color:#64748b;">Abhi koi payment record nahi hai.</p>`;
                return;
            }
            box.innerHTML = `<div class="section-title">Recent Payments</div>` + pays.map(p => `
                <div class="fb-item">
                    <b>${p.name}</b> — ₹<b>${p.amount}</b>
                    ${p.orderCode ? `<span class="status-badge paid-badge">${p.orderCode}</span>` : ''}<br>
                    <small style="color:#475569;">Ref: ${p.ref} | ${p.date}</small>
                </div>
            `).join('');
        }

        function submitFeedback() {
            const name = document.getElementById('fbName').value.trim() || 'Anonymous';
            const rating = document.getElementById('fbRating').value;
            const message = document.getElementById('fbMessage').value.trim();

            if (!message) {
                alert('Kripya apna feedback ya sujhav likhein.');
                return;
            }

            const fbs = getFeedbacks();
            fbs.unshift({
                id: Date.now(),
                name,
                rating,
                message,
                date: new Date().toLocaleString('en-IN')
            });
            if (!saveFeedbacks(fbs)) return;

            document.getElementById('fbName').value = '';
            document.getElementById('fbMessage').value = '';
            alert('Dhanyavaad! Aapka feedback submit ho gaya.');
        }

        function renderFeedbacks() {
            const list = document.getElementById('feedbackList');
            if (!list) return;
            const fbs = getFeedbacks();
            if (!fbs.length) {
                list.innerHTML = `<p style="font-size:12.5px; color:#64748b;">Abhi koi feedback nahi hai.</p>`;
                return;
            }
            list.innerHTML = fbs.map(f => `
                <div class="fb-item">
                    <b>${f.name}</b> — <span>${f.rating}</span>
                    <p style="margin-top:4px; color:#334155;">${f.message}</p>
                    <small style="color:#64748b;">${f.date}</small>
                </div>
            `).join('');
        }

        function loginTech() {
            const pin = document.getElementById('techPin').value.trim();
            if (pin !== TECH_PIN) {
                alert('Galat Technician PIN!');
                return;
            }
            document.getElementById('techLoginBox').style.display = 'none';
            document.getElementById('techDashboard').style.display = 'block';
            renderTechOrders();
        }

        function loginOwner() {
            const pin = document.getElementById('ownerPin').value.trim();
            if (pin !== OWNER_PIN) {
                alert('Galat Owner PIN!');
                return;
            }
            document.getElementById('ownerLoginBox').style.display = 'none';
            document.getElementById('ownerDashboard').style.display = 'block';
            renderOwnerOrders();
        }

        function compressImageFile(file, callback) {
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const maxW = 720;
                    const scale = img.width > maxW ? maxW / img.width : 1;
                    canvas.width = img.width * scale;
                    canvas.height = img.height * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    callback(canvas.toDataURL('image/jpeg', 0.7));
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function stagePhoto(orderId, type, inputEl) {
            const file = inputEl.files && inputEl.files[0];
            if (!file) return;
            compressImageFile(file, (dataUrl) => {
                if (!tempPhotos[orderId]) tempPhotos[orderId] = {};
                tempPhotos[orderId][type] = dataUrl;
                alert(`${type.toUpperCase()} photo attach ho gayi. "Save Photos & Bill" par click karein.`);
            });
        }

        function updateOrderStatus(orderId, newStatus) {
            const orders = getOrders();
            const o = orders.find(item => item.id === orderId);
            if (!o) return;
            o.status = newStatus;
            saveOrders(orders);
        }

        function saveTechWork(orderId) {
            const orders = getOrders();
            const o = orders.find(item => item.id === orderId);
            if (!o) return;

            const amtEl = document.getElementById(`billAmt_${orderId}`);
            const noteEl = document.getElementById(`billNote_${orderId}`);
            if (amtEl) o.billAmount = parseFloat(amtEl.value) || 0;
            if (noteEl) o.billNote = noteEl.value.trim();

            if (!o.photos) o.photos = { repaired: '', part: '', bill: '' };
            if (tempPhotos[orderId]) {
                if (tempPhotos[orderId].repaired) o.photos.repaired = tempPhotos[orderId].repaired;
                if (tempPhotos[orderId].part) o.photos.part = tempPhotos[orderId].part;
                if (tempPhotos[orderId].bill) o.photos.bill = tempPhotos[orderId].bill;
                delete tempPhotos[orderId];
            }

            if (saveOrders(orders)) {
                alert(`${o.orderCode} ka work & bill save ho gaya!`);
            }
        }

        function markOrderPaid(orderId) {
            const orders = getOrders();
            const o = orders.find(item => item.id === orderId);
            if (!o) return;
            o.paid = true;
            o.status = 'Completed';
            saveOrders(orders);
        }

        function renderPhotoGrid(photos) {
            const p = photos || {};
            const placeholder = 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="120" height="90"><rect width="120" height="90" fill="%23e2e8f0"/><text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="%2364748b" font-size="11">No Photo</text></svg>';
            return `
                <div class="photo-grid">
                    <div class="photo-card"><img src="${p.repaired || placeholder}" alt="Repaired"><span>Repaired</span></div>
                    <div class="photo-card"><img src="${p.part || placeholder}" alt="Old Part"><span>Old Part</span></div>
                    <div class="photo-card"><img src="${p.bill || placeholder}" alt="Bill"><span>Bill Photo</span></div>
                </div>
            `;
        }

        function filterOrders(list, searchText, statusFilter) {
            const q = (searchText || '').trim().toLowerCase();
            return list.filter(o => {
                const matchStatus = !statusFilter || statusFilter === 'ALL' || o.status === statusFilter;
                const matchQuery = !q ||
                    (o.orderCode || '').toLowerCase().includes(q) ||
                    (o.name || '').toLowerCase().includes(q) ||
                    (o.phone || '').toLowerCase().includes(q) ||
                    (o.email || '').toLowerCase().includes(q) ||
                    (o.branch || '').toLowerCase().includes(q) ||
                    (o.problem || '').toLowerCase().includes(q);
                return matchStatus && matchQuery;
            });
        }

        function renderTechOrders() {
            const container = document.getElementById('techOrdersList');
            if (!container) return;
            const searchVal = document.getElementById('techSearch')?.value || '';
            const filterVal = document.getElementById('techFilter')?.value || 'ALL';
            const orders = filterOrders(getOrders(), searchVal, filterVal);

            if (!orders.length) {
                container.innerHTML = `<div class="box"><p style="font-size:13px; color:#64748b;">Koi matching order nahi mila.</p></div>`;
                return;
            }

            container.innerHTML = orders.map(o => `
                <div class="order-card">
                    <h4>${o.orderCode} — ${o.name} (${o.branch})</h4>
                    <p><b>Phone:</b> <a href="tel:${o.phone}">${o.phone}</a> | <b>Service:</b> ${o.problem}</p>
                    ${o.email ? `<p><b>Gmail:</b> ${o.email}</p>` : ''}
                    ${o.distanceKm ? `<p><b>Distance:</b> ${o.distanceKm} km</p>` : ''}
                    <p><b>Address:</b> ${o.address}</p>
                    ${o.liveLocLink ? `<p><b>GPS:</b> <a href="${o.liveLocLink}" target="_blank">Open Map</a></p>` : ''}
                    <span class="status-badge ${statusClass(o.status)}">${o.status}</span>
                    <span class="status-badge ${o.paid ? 'paid-badge' : 'unpaid-badge'}">${o.paid ? 'Paid' : 'Unpaid'}</span>

                    <div class="row-flex" style="margin-top:8px;">
                        <button class="btn btn-secondary btn-sm" onclick="updateOrderStatus(${o.id}, 'On The Way')">🚗 On The Way</button>
                        <button class="btn btn-done btn-sm" onclick="updateOrderStatus(${o.id}, 'Completed')">✅ Completed</button>
                    </div>

                    <div class="bill-box">
                        <label style="margin-top:0;">Bill Amount (₹) & Work Note</label>
                        <div class="row-flex">
                            <input type="number" id="billAmt_${o.id}" value="${o.billAmount || ''}" placeholder="Amount ₹" style="flex:1; padding:8px;">
                            <input type="text" id="billNote_${o.id}" value="${o.billNote || ''}" placeholder="Part / Repair note" style="flex:2; padding:8px;">
                        </div>

                        <label>Photos (Repaired / Old Part / Bill)</label>
                        <div class="row-flex" style="font-size:11px;">
                            <div>Repaired: <input type="file" accept="image/*" capture="environment" onchange="stagePhoto(${o.id}, 'repaired', this)" style="width:auto; padding:4px; font-size:11px;"></div>
                            <div>Part: <input type="file" accept="image/*" capture="environment" onchange="stagePhoto(${o.id}, 'part', this)" style="width:auto; padding:4px; font-size:11px;"></div>
                            <div>Bill: <input type="file" accept="image/*" capture="environment" onchange="stagePhoto(${o.id}, 'bill', this)" style="width:auto; padding:4px; font-size:11px;"></div>
                        </div>

                        ${renderPhotoGrid(o.photos)}
                        <button class="btn btn-primary" onclick="saveTechWork(${o.id})">💾 Save Photos & Bill</button>
                    </div>
                </div>
            `).join('');
        }

        function renderOwnerOrders() {
            const container = document.getElementById('ownerOrdersList');
            const statsEl = document.getElementById('ownerStats');
            if (!container) return;

            const allOrders = getOrders();
            const totalRev = allOrders.reduce((sum, o) => sum + (Number(o.billAmount) || 0), 0);
            const pendingCount = allOrders.filter(o => o.status !== 'Completed').length;

            if (statsEl) {
                statsEl.innerHTML = `
                    <div class="stat-box"><strong>${allOrders.length}</strong><span>Total Orders</span></div>
                    <div class="stat-box"><strong>${pendingCount}</strong><span>Active / Pending</span></div>
                    <div class="stat-box"><strong>₹${totalRev}</strong><span>Billed Total</span></div>
                `;
            }

            const searchVal = document.getElementById('ownerSearch')?.value || '';
            const filterVal = document.getElementById('ownerFilter')?.value || 'ALL';
            const orders = filterOrders(allOrders, searchVal, filterVal);

            if (!orders.length) {
                container.innerHTML = `<div class="box"><p style="font-size:13px; color:#64748b;">Koi order nahi mila.</p></div>`;
                return;
            }

            container.innerHTML = orders.map(o => `
                <div class="order-card">
                    <h4>${o.orderCode} — ${o.name} (${o.branch})</h4>
                    <p><b>Phone:</b> <a href="tel:${o.phone}">${o.phone}</a> | <b>Service:</b> ${o.problem}</p>
                    ${o.email ? `<p><b>Gmail:</b> ${o.email}</p>` : ''}
                    ${o.distanceKm ? `<p><b>Distance:</b> ${o.distanceKm} km</p>` : ''}
                    <p><b>Address:</b> ${o.address} <small>(${o.createdAt || ''})</small></p>
                    ${o.liveLocLink ? `<p><b>Live Location:</b> <a href="${o.liveLocLink}" target="_blank">${o.liveLocLink}</a></p>` : ''}
                    <span class="status-badge ${statusClass(o.status)}">${o.status}</span>
                    <span class="status-badge ${o.paid ? 'paid-badge' : 'unpaid-badge'}">${o.paid ? 'Paid' : 'Unpaid'}</span>
                    ${o.billAmount ? `<span class="status-badge" style="background:#fef3c7; color:#92400e;">Bill: ₹${o.billAmount}</span>` : ''}
                    ${o.billNote ? `<p><b>Note:</b> ${o.billNote}</p>` : ''}
                    ${renderPhotoGrid(o.photos)}
                    <div class="row-flex" style="margin-top:8px;">
                        ${!o.paid ? `<button class="btn btn-done btn-sm" onclick="markOrderPaid(${o.id})">₹ Mark Paid & Complete</button>` : ''}
                        <button type="button" class="btn btn-whatsapp btn-sm" onclick="shareOrderBillWhatsApp(${o.id})">📲 WhatsApp Receipt</button>
                    </div>
                </div>
            `).join('');
        }

        // Initialize app
        initCloudSync();
        applyCustomerSession();
        populateOrderSelect();
        renderTrackedOrders();
        renderPayments();
        renderFeedbacks();
    </script>
</body>
</html>
