        async function sendMobileOtp() {
            const name = document.getElementById('loginCustName').value.trim();
            const rawPhone = document.getElementById('loginCustPhone').value.trim();
            const e164 = formatPhoneE164(rawPhone);

            if (!e164 || e164.replace(/\D/g, '').length < 10) {
                alert('Kripya sahi 10-digit Mobile Number daalein.');
                return;
            }

            pendingOtpPhone = e164;
            document.getElementById('otpVerifyBox').style.display = 'block';

            if (authEnabled && auth) {
                try {
                    const verifier = ensureRecaptcha();
                    confirmationResultRef = await auth.signInWithPhoneNumber(e164, verifier);
                    document.getElementById('otpHintText').textContent = `OTP ${e164} par bhej diya gaya hai.`;
                    alert(`OTP ${e164} par bhej diya gaya hai.`);
                    return;
                } catch (err) {
                    alert(`Firebase OTP bhejne mein dikkat aayi: ${err.message}. Demo OTP mode use kiya ja raha hai.`);
                }
            }

            localOtpCode = String(Math.floor(100000 + Math.random() * 900000));
            document.getElementById('otpHintText').textContent = `Local OTP (Firebase Auth inactive): ${localOtpCode}`;
            alert(`Aapka Local Verification OTP hai: ${localOtpCode}`);
        }

        async function verifyMobileOtp() {
            const code = document.getElementById('loginOtpCode').value.trim();
            const name = document.getElementById('loginCustName').value.trim();

            if (!code) {
                alert('Kripya OTP daalein.');
                return;
            }

            if (confirmationResultRef) {
                try {
                    const res = await confirmationResultRef.confirm(code);
                    const user = res.user;
                    setCustomerSession({
                        name: name || user.displayName || 'Customer',
                        phone: user.phoneNumber || pendingOtpPhone,
                        email: user.email || '',
                        method: 'Phone OTP',
                        loggedInAt: new Date().toLocaleString('en-IN')
                    });
                    document.getElementById('otpVerifyBox').style.display = 'none';
                    confirmationResultRef = null;
                    alert('Mobile OTP verify ho gaya aur login safal raha!');
                    return;
                } catch (err) {
                    alert(`OTP galat hai ya expire ho gaya: ${err.message}`);
                    return;
                }
            }

            if (localOtpCode && code === localOtpCode) {
                setCustomerSession({
                    name: name || 'Customer',
                    phone: pendingOtpPhone,
                    email: '',
                    method: 'Local OTP',
                    loggedInAt: new Date().toLocaleString('en-IN')
                });
                document.getElementById('otpVerifyBox').style.display = 'none';
                localOtpCode = '';
                alert('OTP verify ho gaya! Aap login ho gaye hain.');
            } else {
                alert('Galat OTP daala gaya hai. Kripya dobara check karein.');
            }
        }

