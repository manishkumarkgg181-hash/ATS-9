            const rangeInput = document.getElementById('withinRange');

            const bCoord = BRANCH_COORDS[branchName] || BRANCH_COORDS['Khagaria'];
            const distKm = calcDistanceKm(lat, lng, bCoord.lat, bCoord.lng);
            const link = `https://maps.google.com/?q=${lat.toFixed(6)},${lng.toFixed(6)}`;
            const allowed = distKm <= MAX_SERVICE_KM;

            hiddenInput.value = link;
            distInput.value = String(distKm);
            rangeInput.value = allowed ? 'yes' : 'no';

            if (allowed) {
                badge.textContent = `In Range (${distKm} km)`;
                badge.style.color = '#16a34a';
                details.innerHTML = `Lat: <b>${lat.toFixed(6)}</b>, Lng: <b>${lng.toFixed(6)}</b> | ${branchName} se Doori: <b>${distKm} km</b> (Max 25 km allowed)<br><a href="${link}" target="_blank">Google Maps Par Dekhein</a>`;
            } else {
                badge.textContent = `Out of Range (${distKm} km)`;
                badge.style.color = '#dc2626';
                details.innerHTML = `<span style="color:#dc2626; font-weight:600;">${branchName} branch se doori ${distKm} km hai, jo 20–25 km limit se bahar hai.</span> Booking allow nahi hogi.`;
            }
        }

