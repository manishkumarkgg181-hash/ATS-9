    <script>
        const OWNER_PIN = 'ATS@3344';
        const TECH_PIN = 'ATS@7788';
        const DEFAULT_UPI_ID = 'manishkumarkgg181@ybl';
        const WHATSAPP_NUMBER = '917488778228';

        // Apne Firebase Console ki keys yahan bharein (agar khali chhodenge toh Local Storage use hoga)
        const firebaseConfig = {
            apiKey: "",
            authDomain: "",
            databaseURL: "",
            projectId: "",
            storageBucket: "",
            messagingSenderId: "",
            appId: ""
        };

        let db = null;
        let cloudEnabled = false;
        const tempPhotos = {}; // { [orderId]: { repaired: dataUrl, part: dataUrl, bill: dataUrl } }

        function safeLocalSet(key, value) {
            try {
                localStorage.setItem(key, JSON.stringify(value));
                return true;
            } catch (err) {
                alert('Browser storage full ho gaya hai! Nayi photos save karne ke liye purane orders/photos clear karein ya Firebase configure karein.');
                return false;
            }
        }

        function statusClass(status) {
            if (status === 'Completed') return 'completed';
            if (status === 'On The Way') return 'ontheway';
            return 'pending';
        }

        function initCloudSync() {
            try {
                if (firebaseConfig.apiKey && firebaseConfig.databaseURL && window.firebase) {
                    if (!firebase.apps.length) {
                        firebase.initializeApp(firebaseConfig);
                    }
                    db = firebase.database();
                    cloudEnabled = true;
                    document.getElementById('syncStatus').textContent = 'Mode: Live Firebase Cloud Sync';

                    db.ref('ats/orders').on('value', (snap) => {
                        const data = snap.val();
                        if (data) {
                            const arr = Object.values(data).sort((a, b) => b.id - a.id);
                            safeLocalSet('ats_orders_v5', arr);
                            refreshAllViews();
                        }
                    });

                    db.ref('ats/payments').on('value', (snap) => {
                        const data = snap.val();
                        if (data) {
                            const arr = Object.values(data).sort((a, b) => b.id - a.id);
                            safeLocalSet('ats_payments_v5', arr);
                            renderPayments();
                        }
                    });

                    db.ref('ats/feedbacks').on('value', (snap) => {
                        const data = snap.val();
                        if (data) {
                            const arr = Object.values(data).sort((a, b) => b.id - a.id);
                            safeLocalSet('ats_feedback_v5', arr);
                            renderFeedbacks();
                        }
                    });
                }
            } catch (e) {
                cloudEnabled = false;
            }
        }

        function getOrders() {
            return JSON.parse(localStorage.getItem('ats_orders_v5') || '[]');
        }

        function saveOrders(orders) {
            if (!safeLocalSet('ats_orders_v5', orders)) return false;
            if (cloudEnabled && db) {
                const mapObj = {};
                orders.forEach(o => { mapObj[o.id] = o; });
                db.ref('ats/orders').set(mapObj);
            }
            refreshAllViews();
            return true;
        }

        function getPayments() {
            return JSON.parse(localStorage.getItem('ats_payments_v5') || '[]');
        }

        function savePayments(pays) {
            if (!safeLocalSet('ats_payments_v5', pays)) return false;
            if (cloudEnabled && db) {
                const mapObj = {};
                pays.forEach(p => { mapObj[p.id] = p; });
                db.ref('ats/payments').set(mapObj);
            }
            renderPayments();
            return true;
        }

        function getFeedbacks() {
            return JSON.parse(localStorage.getItem('ats_feedback_v5') || '[]');
        }

        function saveFeedbacks(fbs) {
            if (!safeLocalSet('ats_feedback_v5', fbs)) return false;
            if (cloudEnabled && db) {
                const mapObj = {};
                fbs.forEach(f => { mapObj[f.id] = f; });
                db.ref('ats/feedbacks').set(mapObj);
            }
            renderFeedbacks();
            return true;
        }

        function refreshAllViews() {
            populateOrderSelect();
            if (document.getElementById('ownerDashboard').style.display === 'block') renderOwnerOrders();
            if (document.getElementById('techDashboard').style.display === 'block') renderTechOrders();
        }

        function switchTab(tabId, btn) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');

            if (tabId === 'payment') { populateOrderSelect(); renderPayments(); }
            if (tabId === 'feedback') renderFeedbacks();
            if (tabId === 'owner' && document.getElementById('ownerDashboard').style.display === 'block') renderOwnerOrders();
            if (tabId === 'tech'
